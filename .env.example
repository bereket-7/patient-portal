NEXT_PUBLIC_API_URL=http://localhost:3000
# Set false for staging/live API mode (requires running API gateway + seeded data)
NEXT_PUBLIC_DEMO_MODE=false
# When true, authorized accounts load/seed dummy clinical data into Postgres (dev)
NEXT_PUBLIC_USE_DUMMY_HEALTH_DATA=false
# NEXT_PUBLIC_AUTH_JWKS_ENABLED=false
# NEXT_PUBLIC_API_TOKEN=
# With API gateway AUTH_DEV_MODE=true, login mints JWTs via POST /dev/auth/token

# HealthEx Wallet OAuth (OPTIONAL — leave commented for API-key workflow)
# The patient portal does NOT need NEXT_PUBLIC_HEALTHEX_CLIENT_ID for:
#   register → HealthEx consent email → Sync → Authorize & fetch
# That path uses server-side HEALTHEX_API_KEY + HEALTHEX_API_SECRET in backend .env.
# CLIENT_ID is only for the optional "HealthEx Wallet OAuth" button (PKCE redirect).
# Get it from HealthEx org admin / HealthEx support when they register TrialClinIQ
# as an OAuth client (it is NOT your API key from Admin → Manage API Keys).
# NEXT_PUBLIC_HEALTHEX_AUTH_URL=https://wallet.healthex.io/oauth/authorize
# NEXT_PUBLIC_HEALTHEX_CLIENT_ID=

# Live mode checklist:
# 1. docker compose up -d (Postgres, Redis, Redpanda, backend services)
# 2. pnpm build:shared && pnpm dev:gateway
# 3. NEXT_PUBLIC_DEMO_MODE=false (this file)
# 4. Register/login via /dev/patient-accounts or patient portal UI
# 5. Complete HealthEx connect + consent for enterprisePatientId (Member ID)
# 6. Clinical FHIR is upserted into Postgres patient_clinical_profiles and shown in the portal
